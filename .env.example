# Variables de entorno para desarrollo
NODE_ENV=development
PORT=3000

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=tu_password_aqui
DB_DATABASE=ligas_barriales

# Sincronización automática de base de datos
# true = TypeORM crea automáticamente las tablas basándose en las entities (recomendado)
# false = Desactiva sincronización automática (usar solo con migraciones manuales)
# Por defecto es true para facilitar el despliegue inicial
DB_SYNCHRONIZE=true

# JWT Secret
JWT_SECRET=tu_secret_key_aqui_cambiar_en_produccion
JWT_EXPIRATION=24h
